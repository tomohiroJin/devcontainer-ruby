{
  "name": "Ruby Dev Container",
  "customizations": {
    "vscode": {
      "extensions": [
        "Shopify.ruby-lsp",
        "KoichiSasada.vscode-rdbg",
        "EditorConfig.EditorConfig"
      ]
    }
  },
  "postCreateCommand": "bash scripts/setup.sh",
  "remoteUser": "vscode",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "containerEnv": {
    "BUNDLE_APP_CONFIG": "${containerWorkspaceFolder}/.bundle"
  }
}
